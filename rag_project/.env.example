# Bo'sh qoldirilsa -> Qdrant local mode (rag_project/qdrant_db/ papkasi, Docker kerak emas)
# Docker:       docker run -p 6333:6333 qdrant/qdrant   ->  QDRANT_URL=http://localhost:6333
# Qdrant Cloud: https://cloud.qdrant.io                 ->  QDRANT_URL=https://xxx.cloud.qdrant.io  + QDRANT_API_KEY
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=oasis_docs
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
