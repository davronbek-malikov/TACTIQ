# Copy this file to .env and adjust values. Never commit .env.

# --- Rejim ---
# 1 = internetsiz (on-premise): faqat qwen (Ollama), Hugging Face keshdan, Qdrant faqat local/Docker
# 0 = internetli: gemini va groq ham ishlaydi
TACTIQ_OFFLINE=0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tactiq_documents
# Optional: set a folder path to use Qdrant local mode (no Docker), e.g. QDRANT_LOCAL_PATH=qdrant_local
QDRANT_LOCAL_PATH=

# --- Indexing ---
# Relative paths are resolved from the project root.
TACTIQ_RAW_DATA_DIR=Indexing/01_documents/sample_docs
TACTIQ_PROCESSED_DATA_DIR=Indexing/03_chunking/output
TACTIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TACTIQ_EMBEDDING_BATCH_SIZE=32
TACTIQ_CHUNK_SIZE=256
TACTIQ_CHUNK_OVERLAP=25

# --- Hugging Face (optional, for higher download rate limits) ---
HF_TOKEN=

# --- Retrieval & Generation: LLM (kamida bittasini sozlang) ---
# qwen: Ollama o'rnating va `ollama pull qwen2.5:1.5b` (kalit kerak emas)
QWEN_MODEL=qwen2.5:1.5b
# groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
