# Copy this file to .env and adjust values. Never commit .env.

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tactiq_documents
# Optional: set a folder path to use Qdrant local mode (no Docker), e.g. QDRANT_LOCAL_PATH=qdrant_local
QDRANT_LOCAL_PATH=

# --- Indexing ---
TACTIQ_RAW_DATA_DIR=data/raw
TACTIQ_PROCESSED_DATA_DIR=data/processed
TACTIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TACTIQ_EMBEDDING_BATCH_SIZE=32
TACTIQ_CHUNK_SIZE=500
TACTIQ_CHUNK_OVERLAP=50

# --- Hugging Face (optional, for higher download rate limits) ---
HF_TOKEN=
